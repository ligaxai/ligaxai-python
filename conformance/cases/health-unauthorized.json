{
  "name": "health.get with a rejected key raises AuthenticationError",
  "request": { "method": "GET", "path": "/health" },
  "response": {
    "status": 401,
    "headers": { "x-request-id": "req_401" },
    "body": {
      "error": {
        "type": "authentication_error",
        "code": "invalid_api_key",
        "message": "Invalid API key",
        "request_id": "req_401"
      }
    }
  },
  "expect": {
    "call": "health.get",
    "error": { "type": "AuthenticationError", "status_code": 401, "code": "invalid_api_key", "request_id": "req_401" }
  }
}
